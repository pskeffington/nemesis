[Desktop Entry]
Type=Application
Name=Nemesis Operator Air Map
Comment=Launch the aircraft globe as the live KDE desktop with offline fallback
Exec=/usr/local/bin/nemesis-operator-wallpaper
TryExec=/usr/local/bin/nemesis-operator-wallpaper
