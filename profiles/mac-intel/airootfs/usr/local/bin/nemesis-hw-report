#!/usr/bin/env bash
# Read-only Mac hardware inventory for live-media acceptance.
# Output may include hardware details; inspect and redact before publishing.
set -euo pipefail

section() { printf '\n=== %s ===\n' "$1"; }
report() {
  local executable="$1"
  shift
  if command -v "$executable" >/dev/null 2>&1; then
    "$executable" "$@" || printf '(command failed: %s)\n' "$executable"
  else
    printf '(not installed: %s)\n' "$executable"
  fi
}

section "Nemesis hardware report"
date -u '+UTC: %Y-%m-%dT%H:%M:%SZ'
uname -srmo
if [[ -r /sys/class/dmi/id/product_name ]]; then
  printf 'Model: '
  cat /sys/class/dmi/id/product_name
fi
if [[ -d /sys/firmware/efi ]]; then
  printf 'Boot firmware: UEFI\n'
else
  printf 'Boot firmware: non-UEFI or not exposed\n'
fi

section "PCI IDs and kernel drivers"
report lspci -nnk
section "USB devices"
report lsusb
section "Storage (no serial numbers or UUIDs)"
report lsblk -o NAME,TRAN,TYPE,SIZE,MODEL,FSTYPE,MOUNTPOINTS
section "Radio switches"
report rfkill list
section "Network interfaces (no MAC addresses)"
if command -v ip >/dev/null 2>&1; then
  ip -brief link | awk '{print $1, $2}' || true
fi
section "Temperatures (if sensors are configured)"
report sensors
section "Result"
printf 'Inventory complete. This command did not write to internal disks.\n'
printf 'Do not publish any output until reviewed for identifying device data.\n'
